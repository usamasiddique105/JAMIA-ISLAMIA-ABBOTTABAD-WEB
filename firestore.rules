rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Fatwas Collection (Public read & write)
    match /fatwas/{fatwaId} {
      allow read, write: if true;
    }

    // 2. Online Questions / Istifta (Public create & management)
    match /online_questions/{questionId} {
      allow read, write: if true;
    }

    // 3. Online Class Bookings & Admissions (Public create & management)
    match /class_bookings/{bookingId} {
      allow read, write: if true;
    }

    // 4. Exam Results (Public read & management)
    match /exam_results/{resultId} {
      allow read, write: if true;
    }

    // 5. Academic Departments (Public read & management)
    match /departments/{departmentId} {
      allow read, write: if true;
    }

    // 6. Faculty & Shuyookh (Public read & management)
    match /faculty/{facultyId} {
      allow read, write: if true;
    }

    // 7. Library Publications & Books (Public read & management)
    match /books/{bookId} {
      allow read, write: if true;
    }

    // 8. Media Gallery (Public read & management)
    match /media/{mediaId} {
      allow read, write: if true;
    }

    // 9. News & Announcements (Public read & management)
    match /news/{newsId} {
      allow read, write: if true;
    }

    // 10. Donations & Zakat Records (Public read & write)
    match /donations/{donationId} {
      allow read, write: if true;
    }

    // 11. Site Settings (Public read & management)
    match /site_settings/{settingId} {
      allow read, write: if true;
    }

    // 12. Test Connection Collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
